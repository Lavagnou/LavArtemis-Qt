<?xml version="1.0" encoding="utf-8"?>
<!-- French strings of the installer window (theme/<channel>/thm.xml, generated by LavArtemis
     docs/branding/generate-installer.mjs). Shared by both channels: [LavDisplayName] and [LavVersion]
     are bundle variables of Bundle.wxs. Same wording as the app: "tu", French everywhere.
     The ids WixStdBA reads by itself (ConfirmCancelMessage, FilesInUse*, Execute*) must stay.
     Button, checkbox, link and title-bar texts are drawn into images by generate-installer.mjs: they
     are not here. Never add a string whose id is the Name of a control without text (OptionsOkButton,
     LaunchButton...): thmutil gives such a control the text of #(loc.<Name>) and draws it over the
     image, in the button's font colour. -->
<WixLocalization Culture="fr-FR" Language="1036" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="[LavDisplayName] — Installation" />
  <String Id="Title" Value="[LavDisplayName]" />
  <String Id="CheckingForUpdatesLabel" Value="Recherche de mises à jour" />
  <String Id="ConfirmCancelMessage" Value="Fermer l'installeur ?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Version précédente" />

  <String Id="HelpHeader" Value="Aide" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [dossier] : installe, répare, désinstalle, ou copie l'installeur complet dans un dossier. Installer est le choix par défaut.&#xA;/passive | /quiet : fenêtre de progression seule, ou aucune fenêtre, sans aucune question.&#xA;/norestart : ne redémarre jamais l'ordinateur.&#xA;/log journal.txt : écrit le journal dans ce fichier (par défaut dans %TEMP%)." />

  <String Id="InstallMessage" Value="Tes jeux et ton bureau, en stream depuis tes PC.&#xA;Version [LavVersion]" />
  <String Id="InstallFolderLabel" Value="Dossier : [InstallFolder] ·" />

  <String Id="OptionsHeader" Value="Dossier d'installation" />

  <String Id="ProgressHeader" Value="Installation…" />
  <String Id="ProgressPassiveHeader" Value="Mise à jour…" />
  <String Id="ProgressUninstallHeader" Value="Désinstallation…" />
  <String Id="ProgressRepairHeader" Value="Réparation…" />
  <String Id="ProgressMessage" Value="Version [LavVersion].&#xA;Tes réglages et tes PC appairés sont gardés." />
  <String Id="ProgressPassiveMessage" Value="Vers la version [LavVersion].&#xA;[LavDisplayName] se relance à la fin." />
  <String Id="ProgressUninstallMessage" Value="Quelques secondes." />

  <String Id="ModifyMessage" Value="Version [LavVersion], déjà installée.&#xA;Tu peux la réparer ou la désinstaller." />

  <String Id="SuccessHeader" Value="C'est prêt." />
  <String Id="SuccessRepairHeader" Value="Réparée." />
  <String Id="SuccessUninstallHeader" Value="Désinstallée." />
  <String Id="SuccessMessage" Value="[LavDisplayName] [LavVersion] est installée.&#xA;Tes réglages et tes PC appairés sont gardés." />
  <String Id="SuccessUninstallMessage" Value="Ses réglages et ses PC appairés ont été effacés de ce PC." />
  <String Id="SuccessRestartText" Value="Redémarre l'ordinateur pour terminer l'installation." />
  <String Id="SuccessUninstallRestartText" Value="Redémarre l'ordinateur pour terminer la désinstallation." />

  <String Id="FailureHeader" Value="L'installation a échoué" />
  <String Id="FailureRepairHeader" Value="La réparation a échoué" />
  <String Id="FailureUninstallHeader" Value="La désinstallation a échoué" />
  <String Id="FailureHyperlinkLogText" Value="Le détail de l'erreur est dans le &lt;a href=&quot;#&quot;&gt;journal d'installation&lt;/a&gt;." />
  <String Id="FailureRestartText" Value="Redémarre l'ordinateur pour finir d'annuler l'installation." />

  <String Id="FilesInUseTitle" Value="Fichiers utilisés" />
  <String Id="FilesInUseLabel" Value="Ces applications utilisent des fichiers à mettre à jour :" />
  <String Id="FilesInUseNetfxCloseRadioButton" Value="Fermer les &amp;applications." />
  <String Id="FilesInUseCloseRadioButton" Value="Fermer les &amp;applications et essayer de les relancer." />
  <String Id="FilesInUseDontCloseRadioButton" Value="&amp;Ne pas les fermer. Un redémarrage sera nécessaire." />
  <String Id="FilesInUseRetryButton" Value="&amp;Réessayer" />
  <String Id="FilesInUseIgnoreButton" Value="&amp;Ignorer" />
  <String Id="FilesInUseExitButton" Value="&amp;Quitter" />
</WixLocalization>
