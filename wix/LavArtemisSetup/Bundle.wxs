<!-- This block is autogenerated using scripts\update-msvcredist.ps1 -->
<?define VCREDIST_VER = "14.40.33810.0" ?>
<?define VCREDIST_X64_SIZE = "25397512" ?>
<?define VCREDIST_X64_SHA512 = "5935B69F5138AC3FBC33813C74DA853269BA079F910936AEFA95E230C6092B92F6225BFFB594E5DD35FF29BF260E4B35F91ADEDE90FDF5F062030D8666FD0104" ?>
<?define VCREDIST_X64_URL = "https://download.visualstudio.microsoft.com/download/pr/1754ea58-11a6-44ab-a262-696e194ce543/3642E3F95D50CC193E4B5A0B0FFBF7FE2C08801517758B4C8AEB7105A091208A/VC_redist.x64.exe" ?>
<?define VCREDIST_X64_UPGRADE_CODE = "36F68A90-239C-34DF-B58C-64B30153CE35" ?>
<?define VCREDIST_ARM64_SIZE = "11531032" ?>
<?define VCREDIST_ARM64_SHA512 = "76A467E992E4F2CBAE261CFB8C64274782E3D420A61F52458662AA1C3A843ED8F4E340D4C237BB080BE1F2E86D7C4E5F4859FFDA8FDCA4E77375FD4D49663D14" ?>
<?define VCREDIST_ARM64_URL = "https://download.visualstudio.microsoft.com/download/pr/1754ea58-11a6-44ab-a262-696e194ce543/15B8F5B2106DC7A7BD83AB57B796770E0F4ECB891AD19BF655C9D6A9DA650AD2/VC_redist.arm64.exe" ?>
<?define VCREDIST_ARM64_UPGRADE_CODE = "DC9BAE42-810B-423A-9E25-E4073F1C7B00" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

<!-- LavArtemis Dev: see wix/LavArtemis/Product.wxs.

     Bundle upgrade codes: NEW since the renumbering (Dev 0.7.0-dev.1, stable
     1.0.0). Burn refuses a bundle older than an installed related bundle, and
     0.7 is "older" than 21.8: with the old codes, the jump would fail. Under a
     new code the 21.x bundle is not related, the MSI's Upgrade table replaces
     its MSI (row (c) in Product.wxs), and Burn's downgrade check protects the
     new numbering from then on.
     Left behind once: the 21.x bundle's entry in "Applications installées".
     Uninstalling it is harmless: its MSI (found by its own ProductCode) is
     already gone and the VC++ redistributables are Permanent. Do not "repair"
     it: that would reinstall its 21.x MSI, whose table sees 0.7 as older.
     Old codes, never reuse: Dev 0f199e84-5a47-4311-bec5-4330a80c1095,
     stable 0dc77dbb-91d2-4126-9993-558fbe74ae28. -->
<?if "$(var.LavChannel)" = "dev" ?>
<?define BundleName = "LavArtemis Dev Game Streaming Client" ?>
<?define BundleUpgradeCode = "72171b88-37c9-4543-9707-1cd668b848a4" ?>
<?define BundleFolder = "LavArtemis Dev" ?>
<?define BundleRegKey = "Software\LavArtemis Dev" ?>
<?define BundleIcon = "..\..\app\lavartemis-dev.ico" ?>
<?define DisplayName = "LavArtemis Dev" ?>
<?define ThemeDir = "dev" ?>
<?else?>
<?define BundleName = "LavArtemis Game Streaming Client" ?>
<?define BundleUpgradeCode = "51150c91-b139-4a69-aa95-e8e6df6efaec" ?>
<?define BundleFolder = "LavArtemis Game Streaming" ?>
<?define BundleRegKey = "Software\LavArtemis" ?>
<?define BundleIcon = "..\..\app\lavartemis.ico" ?>
<?define DisplayName = "LavArtemis" ?>
<?define ThemeDir = "stable" ?>
<?endif?>
  <Bundle Name="$(var.BundleName)"
          Version="!(bind.PackageVersion.Artemis_x64)"
          Manufacturer="LavArtemis"
          UpgradeCode="$(var.BundleUpgradeCode)"
          HelpUrl="https://github.com/wjbeckett/artemis/wiki/Setup-Guide"
          UpdateUrl="https://github.com/wjbeckett/artemis/releases"
          DisableModify="yes"
          IconSourceFile="$(var.BundleIcon)">

    <bal:Condition Message="$(var.DisplayName) demande Windows 10 ou plus récent." Condition="VersionNT &gt;= v10.0" />
    <bal:Condition Message="$(var.DisplayName) demande une version 64 bits de Windows." Condition="NativeMachine &lt;&gt; 332" />

    <!-- Shown by the installer window (theme/thm.wxl): the short name, and the readable version
         ("0.7.0-dev.5"; the bundle version is the numeric 0.7.0.5). -->
    <Variable Name="LavDisplayName" Value="$(var.DisplayName)" />
    <Variable Name="LavVersion" Value="$(var.LavVersion)" />

    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles6432Folder]$(var.BundleFolder)" />

    <!-- Define "Add desktop shortcut" -checkbox's state by defining a variable
         which has same name as the checkbox has. Value 1 means that checkbox
         is checked, 0 means that is unchecked-->
    <!-- Set checkbox's state as checked by default -->
    <Variable Name="AddDesktopShortcutCheckbox" Type="numeric" Value="1" />
    <!-- Get checkbox's state from registry if present. The registry value
         "DesktopShortcutInstallState" is set in Product.wxs. -->
    <util:RegistrySearch Variable="HasDesktopShortcutInstallStateRegKey" Root="HKCU" Key="$(var.BundleRegKey)" Value="DesktopShortcutInstallState" Result="exists" />
    <util:RegistrySearch Variable="AddDesktopShortcutCheckbox" Root="HKCU" Key="$(var.BundleRegKey)" Value="DesktopShortcutInstallState" Condition="HasDesktopShortcutInstallStateRegKey" />

    <util:ProductSearch Id="VCREDIST_14_x64"
                        UpgradeCode="$(var.VCREDIST_X64_UPGRADE_CODE)"
                        Result="version"
                        Variable="VCREDIST_14_x64" />

    <util:ProductSearch Id="VCREDIST_14_ARM64"
                        UpgradeCode="$(var.VCREDIST_ARM64_UPGRADE_CODE)"
                        Result="version"
                        Variable="VCREDIST_14_ARM64" />

    <BootstrapperApplication>
      <!-- Own window, direction "A" of the prototype canvas (page V7). theme/<channel>/ is generated by
           LavArtemis docs/branding/generate-installer.mjs (thm.xml, images, payloads.wxi); the French
           strings are theme/thm.wxl.
           Theme="hyperlinkLicense" only for its plumbing: ThemeFile and LocalizationFile replace its
           window and strings. Not Theme="none": WiX then omits the WixStdbaInformation data, and
           WixStdBA fails to start (0x80070490, nothing on screen). There is no licence page: the
           theme has no EulaAcceptCheckbox, so the licence link below is never shown. -->
      <bal:WixStandardBootstrapperApplication LaunchTarget="[InstallFolder]\LavArtemis.exe"
                                              Theme="hyperlinkLicense"
                                              ThemeFile="theme\$(var.ThemeDir)\thm.xml"
                                              LocalizationFile="theme\thm.wxl"
                                              LogoFile="theme\$(var.ThemeDir)\lav-logo.png"
                                              LicenseUrl="https://github.com/Lavagnou/LavArtemis-Qt/blob/main/LICENSE" />
      <Payload Name="lavartemis.ico" SourceFile="$(var.BundleIcon)" Compressed="yes" />
      <?include theme\$(var.ThemeDir)\payloads.wxi ?>
    </BootstrapperApplication>

    <Chain>
      <ExePackage Cache="remove"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  InstallCondition="(VersionNT64 AND NOT NativeMachine) OR (NativeMachine = 34404)"
                  DetectCondition="VCREDIST_14_x64 &gt;= v$(var.VCREDIST_VER)"
                  InstallArguments="/install /quiet /norestart">

        <ExePackagePayload Description="Microsoft Visual C++ 2015-2022 Redistributable - x64"
                           ProductName="Microsoft Visual C++ 2015-2022 Redistributable - x64"
                           Size="$(var.VCREDIST_X64_SIZE)"
                           Version="$(var.VCREDIST_VER)"
                           Hash="$(var.VCREDIST_X64_SHA512)"
                           Name="VC_redist.x64.exe"
                           DownloadUrl="$(var.VCREDIST_X64_URL)" />

        <!-- Newer version installed is fine -->
        <ExitCode Value="1638" Behavior="success" />
      </ExePackage>

      <ExePackage Cache="remove"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  InstallCondition="NativeMachine = 43620"
                  DetectCondition="VCREDIST_14_ARM64 &gt;= v$(var.VCREDIST_VER)"
                  InstallArguments="/install /quiet /norestart">

        <ExePackagePayload Description="Microsoft Visual C++ 2015-2022 Redistributable - ARM64"
                           ProductName="Microsoft Visual C++ 2015-2022 Redistributable - ARM64"
                           Size="$(var.VCREDIST_ARM64_SIZE)"
                           Version="$(var.VCREDIST_VER)"
                           Hash="$(var.VCREDIST_ARM64_SHA512)"
                           Name="VC_redist.arm64.exe"
                           DownloadUrl="$(var.VCREDIST_ARM64_URL)" />

        <!-- Newer version installed is fine -->
        <ExitCode Value="1638" Behavior="success" />
      </ExePackage>

      <MsiPackage Id="Artemis_x64"
                  SourceFile="$(env.BUILD_ROOT)\build-x64-$(env.BUILD_CONFIG)\LavArtemis.msi"
                  Name="Artemis_x64.msi"
                  InstallCondition="(VersionNT64 AND NOT NativeMachine) OR (NativeMachine = 34404)"
                  Vital="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="ADDDESKTOPSHORTCUT" Value="[AddDesktopShortcutCheckbox]" />
      </MsiPackage>

      <!-- LAV_X64_ONLY=1 (local release build, no Qt arm64 kit on that PC): x64 only -->
      <?if $(var.X64Only) != "1" ?>
      <MsiPackage Id="Artemis_arm64"
                  SourceFile="$(env.BUILD_ROOT)\build-arm64-$(env.BUILD_CONFIG)\LavArtemis.msi"
                  Name="Artemis_arm64.msi"
                  InstallCondition="NativeMachine = 43620"
                  Vital="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="ADDDESKTOPSHORTCUT" Value="[AddDesktopShortcutCheckbox]" />
      </MsiPackage>
      <?endif ?>
    </Chain>

  </Bundle>
</Wix>
