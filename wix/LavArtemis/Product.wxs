<?define ShortName = "LavArtemis" ?>
<?define FullName = "LavArtemis Game Streaming Client" ?>

<?define ShortcutName = "$(var.ShortName)" ?>
<?define ShortcutDesc = "Stream games and other applications from another PC" ?>
<?define InstallFolder = "LavArtemis" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="$(var.FullName)"
           Language="1033"
           Version="!(bind.fileVersion.LavArtemisExe)"
           Manufacturer="LavArtemis"
           UpgradeCode="0a9086a7-5fd5-4ca1-9489-5e2c0d6be8ef">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate CompressionLevel="high" EmbedCab="yes" />

    <Property Id="MPSSVC_START">
      <RegistrySearch Id="MpsSvcStart"
                      Root="HKLM"
                      Key="System\CurrentControlSet\Services\MpsSvc"
                      Name="Start"
                      Type="raw" />
    </Property>

    <Launch Condition="Installed OR MPSSVC_START=&quot;#2&quot;"
            Message="Setup requires Windows Firewall service (MpsSvc) to be running. Please start the service and try again." />

    <Property Id="APPDATAFOLDER" Value="%LOCALAPPDATA%\LavArtemis" />

    <!-- There's no way to delete a registry key on uninstall but not major upgrade, so
        we have to roll our own deletion via custom action -->
    <CustomAction Id="DeleteRegistryKey"
                  Directory="ProgramFiles6432Folder"
                  ExeCommand="reg.exe delete &quot;HKCU\Software\LavArtemis&quot; /f"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="DeleteRegistryKey"
              Before="InstallFinalize"
              Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Component Id="ArtemisShortcuts" Directory="INSTALLFOLDER">
      <Shortcut Id="StartMenuShortcut"
                Name="$(var.ShortcutName)"
                Description="$(var.ShortcutDesc)"
                Target="[#LavArtemisExe]"
                Directory="ApplicationProgramsFolder"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupStartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    On="uninstall" />
      <util:RemoveFolderEx Id="CleanupAppDataFolder"
                           On="uninstall"
                           Property="APPDATAFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\LavArtemis"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>


    <Component Id="ArtemisDesktopShortcut" Directory="INSTALLFOLDER" Condition="ADDDESKTOPSHORTCUT=1">
      <Shortcut Id="DesktopShortcut"
                Name="$(var.ShortcutName)"
                Description="$(var.ShortcutDesc)"
                Target="[#LavArtemisExe]"
                Directory="DesktopFolder"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupDesktopShortcut"
                    Directory="DesktopFolder"
                    On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\LavArtemis"
                     Name="DesktopShortcutInstalled"
                     Type="integer"
                     Value="1" />
      <RegistryValue Root="HKCU"
                     Key="Software\LavArtemis"
                     Name="DesktopShortcutInstallState"
                     Type="integer"
                     Value="[ADDDESKTOPSHORTCUT]"
                     KeyPath="yes" />
    </Component>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="LavArtemis">
        <File Id="LavArtemisExe"
              KeyPath="yes"
              Checksum="yes"
              Source="$(var.BuildDir)\app\$(var.Configuration)\LavArtemis.exe">
          <fire:FirewallException Id="ArtemisFirewallException"
                                  Scope="any"
                                  IgnoreFailure="yes"
                                  Name="$(var.ShortName)" />
        </File>
      </Component>
    </DirectoryRef>

    <!-- art:// links, so a browser or a desktop shortcut can pair with a host
         or launch an app directly. Registered under HKCU because the rest of
         this package's per-user state lives there too. -->
    <Component Id="ArtUrlScheme" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\Classes\art"
                     Value="URL:LavArtemis Protocol" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\art"
                     Name="URL Protocol" Value="" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\art\DefaultIcon"
                     Value="&quot;[#LavArtemisExe]&quot;,0" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\art\shell\open\command"
                     Value="&quot;[#LavArtemisExe]&quot; &quot;%1&quot;" Type="string" />
    </Component>

    <!-- .art launcher files, the same format the Android client exports. -->
    <Component Id="ArtFileAssociation" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\Classes\.art"
                     Value="LavArtemis.Shortcut" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\LavArtemis.Shortcut"
                     Value="LavArtemis app shortcut" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\LavArtemis.Shortcut\DefaultIcon"
                     Value="&quot;[#LavArtemisExe]&quot;,0" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\LavArtemis.Shortcut\shell\open\command"
                     Value="&quot;[#LavArtemisExe]&quot; &quot;%1&quot;" Type="string" />
    </Component>

    <ComponentGroup Id="ArtemisDependencies" Directory="INSTALLFOLDER">
      <Files Include="$(var.DeployDir)\**" />
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="LavArtemis" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="LavArtemis" />
      <ComponentRef Id="ArtemisShortcuts" />
      <ComponentRef Id="ArtemisDesktopShortcut" />
      <ComponentRef Id="ArtUrlScheme" />
      <ComponentRef Id="ArtFileAssociation" />
      <ComponentGroupRef Id="ArtemisDependencies" />
    </Feature>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolder)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.InstallFolder)" />
    </StandardDirectory>
  </Package>
</Wix>
