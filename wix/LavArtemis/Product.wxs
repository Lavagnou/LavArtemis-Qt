<!-- The channel comes from scripts/build-arch.bat (LAV_CHANNEL=dev for a
     "-dev." version). LavArtemis Dev installs next to the stable app: its own
     names, folders, registry key and upgrade code, and it leaves art:// and
     .art to the stable app. Stable values must stay exactly as they are. -->
<?if "$(var.LavChannel)" = "dev" ?>
<?define ShortName = "LavArtemis Dev" ?>
<?define FullName = "LavArtemis Dev Game Streaming Client" ?>
<?define InstallFolder = "LavArtemis Dev" ?>
<?define RegKey = "Software\LavArtemis Dev" ?>
<?define ProductUpgradeCode = "772478fe-f84c-4d7e-801e-71c3c8277257" ?>
<?else?>
<?define ShortName = "LavArtemis" ?>
<?define FullName = "LavArtemis Game Streaming Client" ?>
<?define InstallFolder = "LavArtemis" ?>
<?define RegKey = "Software\LavArtemis" ?>
<?define ProductUpgradeCode = "0a9086a7-5fd5-4ca1-9489-5e2c0d6be8ef" ?>
<?endif?>

<?define ShortcutName = "$(var.ShortName)" ?>
<?define ShortcutDesc = "Stream games and other applications from another PC" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="$(var.FullName)"
           Language="1033"
           Version="!(bind.fileVersion.LavArtemisExe)"
           Manufacturer="LavArtemis"
           UpgradeCode="$(var.ProductUpgradeCode)">
    <!-- Upgrades, written out instead of MajorUpgrade because of the renumbering.
         Up to 21.x the version came from Moonlight; LavArtemis now counts on its
         own (Dev 0.7.0-dev.N, stable 1.0.0 later). The MSI version is the exe's
         (0.7.0-dev.3 -> 0.7.0.3) and the MSI compares only the first three fields.

         (a) 0.0.0 up to this version: upgraded. The Dev also replaces the same
             version, since its builds differ only by the ignored fourth field
             (Burn's own bundle check refuses an older Dev build).
         (b) above this version, below 20.0.0: a newer LavArtemis. Only detected,
             and the launch condition below refuses to install: the permanent
             downgrade protection.
         (c) 20.0.0 and above: the old Moonlight-derived numbering (21.x).
             Upgraded whatever the number, so 0.7 replaces a 21.8 once.

         INVARIANT: the new numbering stays below 20.0.0 forever, or (c) would
         take a real newer version for an old one and downgrade over it.
         scripts/build-arch.bat refuses to build a version of 20 or more.

         The old product is removed by RemoveExistingProducts with
         UPGRADINGPRODUCTCODE set, whichever row found it, so its own
         "NOT UPGRADINGPRODUCTCODE" keeps HKCU and the settings, as MajorUpgrade did. -->
    <Upgrade Id="$(var.ProductUpgradeCode)">
<?if "$(var.LavChannel)" = "dev" ?>
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
                      Maximum="!(bind.fileVersion.LavArtemisExe)" IncludeMaximum="yes"
                      MigrateFeatures="yes" Property="LAV_UPGRADE_DETECTED" />
<?else?>
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
                      Maximum="!(bind.fileVersion.LavArtemisExe)" IncludeMaximum="no"
                      MigrateFeatures="yes" Property="LAV_UPGRADE_DETECTED" />
<?endif?>
      <UpgradeVersion Minimum="!(bind.fileVersion.LavArtemisExe)" IncludeMinimum="no"
                      Maximum="20.0.0" IncludeMaximum="no"
                      OnlyDetect="yes" Property="LAV_NEWER_DETECTED" />
      <UpgradeVersion Minimum="20.0.0" IncludeMinimum="yes"
                      MigrateFeatures="yes" Property="LAV_LEGACY_DETECTED" />
    </Upgrade>
    <Launch Condition="NOT LAV_NEWER_DETECTED"
            Message="Une version plus récente de [ProductName] est déjà installée." />
    <MediaTemplate CompressionLevel="high" EmbedCab="yes" />

    <Property Id="MPSSVC_START">
      <RegistrySearch Id="MpsSvcStart"
                      Root="HKLM"
                      Key="System\CurrentControlSet\Services\MpsSvc"
                      Name="Start"
                      Type="raw" />
    </Property>

    <Launch Condition="Installed OR MPSSVC_START=&quot;#2&quot;"
            Message="Setup requires Windows Firewall service (MpsSvc) to be running. Please start the service and try again." />

    <Property Id="APPDATAFOLDER" Value="%LOCALAPPDATA%\$(var.InstallFolder)" />

    <!-- There's no way to delete a registry key on uninstall but not major upgrade, so
        we have to roll our own deletion via custom action -->
    <CustomAction Id="DeleteRegistryKey"
                  Directory="ProgramFiles6432Folder"
                  ExeCommand="reg.exe delete &quot;HKCU\$(var.RegKey)&quot; /f"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="yes" />
    <InstallExecuteSequence>
      <!-- Old product out first, as MajorUpgrade Schedule="afterInstallInitialize" did -->
      <RemoveExistingProducts After="InstallInitialize" />
      <Custom Action="DeleteRegistryKey"
              Before="InstallFinalize"
              Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Component Id="ArtemisShortcuts" Directory="INSTALLFOLDER">
      <Shortcut Id="StartMenuShortcut"
                Name="$(var.ShortcutName)"
                Description="$(var.ShortcutDesc)"
                Target="[#LavArtemisExe]"
                Directory="ApplicationProgramsFolder"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupStartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    On="uninstall" />
      <util:RemoveFolderEx Id="CleanupAppDataFolder"
                           On="uninstall"
                           Property="APPDATAFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="$(var.RegKey)"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>


    <Component Id="ArtemisDesktopShortcut" Directory="INSTALLFOLDER" Condition="ADDDESKTOPSHORTCUT=1">
      <Shortcut Id="DesktopShortcut"
                Name="$(var.ShortcutName)"
                Description="$(var.ShortcutDesc)"
                Target="[#LavArtemisExe]"
                Directory="DesktopFolder"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanupDesktopShortcut"
                    Directory="DesktopFolder"
                    On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="$(var.RegKey)"
                     Name="DesktopShortcutInstalled"
                     Type="integer"
                     Value="1" />
      <RegistryValue Root="HKCU"
                     Key="$(var.RegKey)"
                     Name="DesktopShortcutInstallState"
                     Type="integer"
                     Value="[ADDDESKTOPSHORTCUT]"
                     KeyPath="yes" />
    </Component>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="LavArtemis">
        <File Id="LavArtemisExe"
              KeyPath="yes"
              Checksum="yes"
              Source="$(var.BuildDir)\app\$(var.Configuration)\LavArtemis.exe">
          <fire:FirewallException Id="ArtemisFirewallException"
                                  Scope="any"
                                  IgnoreFailure="yes"
                                  Name="$(var.ShortName)" />
        </File>
      </Component>
    </DirectoryRef>

<?if "$(var.LavChannel)" != "dev" ?>
    <!-- art:// links, so a browser or a desktop shortcut can pair with a host
         or launch an app directly. Registered under HKCU because the rest of
         this package's per-user state lives there too. -->
    <Component Id="ArtUrlScheme" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\Classes\art"
                     Value="URL:LavArtemis Protocol" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\art"
                     Name="URL Protocol" Value="" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\art\DefaultIcon"
                     Value="&quot;[#LavArtemisExe]&quot;,0" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\art\shell\open\command"
                     Value="&quot;[#LavArtemisExe]&quot; &quot;%1&quot;" Type="string" />
    </Component>

    <!-- .art launcher files, the same format the Android client exports. -->
    <Component Id="ArtFileAssociation" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\Classes\.art"
                     Value="LavArtemis.Shortcut" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\LavArtemis.Shortcut"
                     Value="LavArtemis app shortcut" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\LavArtemis.Shortcut\DefaultIcon"
                     Value="&quot;[#LavArtemisExe]&quot;,0" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\LavArtemis.Shortcut\shell\open\command"
                     Value="&quot;[#LavArtemisExe]&quot; &quot;%1&quot;" Type="string" />
    </Component>

<?endif?>

    <ComponentGroup Id="ArtemisDependencies" Directory="INSTALLFOLDER">
      <Files Include="$(var.DeployDir)\**" />
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="$(var.ShortName)" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="LavArtemis" />
      <ComponentRef Id="ArtemisShortcuts" />
      <ComponentRef Id="ArtemisDesktopShortcut" />
<?if "$(var.LavChannel)" != "dev" ?>
      <ComponentRef Id="ArtUrlScheme" />
      <ComponentRef Id="ArtFileAssociation" />
<?endif?>
      <ComponentGroupRef Id="ArtemisDependencies" />
    </Feature>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.InstallFolder)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.InstallFolder)" />
    </StandardDirectory>
  </Package>
</Wix>
